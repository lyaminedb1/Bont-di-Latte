---
import '../styles/global.css';
import { site } from '../config/site';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Chemin sans langue, ex. '' pour l'accueil, 'merci/' pour la page merci. */
  path?: string;
  noindex?: boolean;
}

const { lang, title, description, path = '', noindex = false } = Astro.props;
const d = t(lang);
const base = site.url.replace(/\/$/, '');
const urlFor = (l: Lang) => `${base}${l === 'fr' ? '/' : '/ar/'}${path}`;
const canonical = urlFor(lang);
const ogImage = `${base}/og-image.png`;

const fontsBase = 'https://fonts.googleapis.com/css2?';
const latinFonts = `${fontsBase}family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..600&family=Work+Sans:wght@400;500;600&display=swap`;
// En français, on ne charge que les glyphes arabes du sélecteur de langue (quelques octets).
const arabicFonts =
  lang === 'ar'
    ? `${fontsBase}family=Noto+Naskh+Arabic:wght@400;600;700&display=swap`
    : `${fontsBase}family=Noto+Naskh+Arabic:wght@500&display=swap&text=${encodeURIComponent('العربية')}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${base}/#fromagerie`,
  name: site.name,
  description: t('fr').meta.description,
  url: `${base}/`,
  logo: `${base}/img/logo-ovale-960.png`,
  image: ogImage,
  telephone: site.contact.phoneHref,
  address: { '@type': 'PostalAddress', streetAddress: site.contact.address.fr, addressCountry: 'DZ' },
  areaServed: 'DZ',
  hasMap: site.contact.mapsUrl,
};
---

<!doctype html>
<html lang={lang} dir={d.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {!noindex && (
      <>
        <link rel="alternate" hreflang="fr" href={urlFor('fr')} />
        <link rel="alternate" hreflang="ar" href={urlFor('ar')} />
        <link rel="alternate" hreflang="x-default" href={urlFor('fr')} />
      </>
    )}
    <meta name="theme-color" content="#142E52" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_DZ' : 'ar_DZ'} />
    <meta property="og:locale:alternate" content={lang === 'fr' ? 'ar_DZ' : 'fr_DZ'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Polices Google : chargées sans bloquer l'affichage -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={latinFonts} media="print" onload="this.media='all'" />
    <link rel="stylesheet" href={arabicFonts} media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href={latinFonts} />
      <link rel="stylesheet" href={arabicFonts} />
    </noscript>

    <script is:inline>document.documentElement.classList.add('js');</script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenu">{d.a11y.skip}</a>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
