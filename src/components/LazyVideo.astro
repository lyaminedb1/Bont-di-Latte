---
// Vidéo de section : rien n'est téléchargé avant l'approche de l'écran (voir scripts/main.ts),
// pause automatique hors écran, poster seul si mouvement réduit ou économie de données.
import type { VideoSet } from '../lib/media';
interface Props { video: VideoSet; label: string; ratio?: string }
const { video, label, ratio = '4 / 5' } = Astro.props;
---
<div class="lazy-video" style={`aspect-ratio:${ratio}`}>
  <video muted loop playsinline preload="none" poster={video.poster} data-lazy-video aria-label={label}>
    {video.webm && <source data-src={video.webm} type="video/webm" />}
    <source data-src={video.mp4} type="video/mp4" />
  </video>
</div>
<style>
  .lazy-video { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--navy-deep); }
  .lazy-video video { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
</style>
