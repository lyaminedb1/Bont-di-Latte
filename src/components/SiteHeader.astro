---
import { t, localePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { categories, productDetails, recipes } from '../data/catalog';
import { site } from '../config/site';
import Icon from './Icon.astro';

interface Props { lang: Lang; current?: 'recettes' | 'produits' | 'histoire' | 'pro' | 'contact' | 'home' }
const { lang, current } = Astro.props;
const d = t(lang);
const u = ui[lang];
const L = (p = '') => localePath(lang, p);
// Lien vers la même page dans l'autre langue
const pathNoLang = Astro.url.pathname.replace(/^\/ar(\/|$)/, '/');
const otherHref = lang === 'fr' ? `/ar${pathNoLang}` : pathNoLang;
---

<header class="sh" data-header>
  <div class="container sh-inner">
    <button class="sh-burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-principal"
      data-label-open={u.nav.menu} data-label-close={u.nav.close}>
      <span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="sr-only" data-menu-label>{u.nav.menu}</span>
    </button>

    <a class="sh-logo" href={L()} aria-label={d.a11y.home}>
      <img src="/img/logo-ovale-480.webp" srcset="/img/logo-ovale-480.webp 480w, /img/logo-ovale-720.webp 720w" sizes="11rem"
        width="480" height="248" alt="" />
    </a>

    <nav class="sh-nav" id="menu-principal" aria-label={d.a11y.mainNav} data-menu>
      <ul class="sh-list">
        <li class="has-sub" data-sub>
          <button class="sh-link" type="button" aria-expanded="false" aria-controls="sous-menu-recettes" aria-current={current === 'recettes' ? 'page' : undefined}>
            {u.nav.recipes}<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div class="sh-panel" id="sous-menu-recettes">
            <ul>
              {categories.map((c) => <li><a href={`${L('recettes/')}?cat=${c.id}`}>{c.label[lang]}</a></li>)}
            </ul>
            <ul class="sh-panel-feature">
              {recipes.slice(0, 3).map((r) => <li><a href={L(`recettes/${r.slug}/`)}>{r.title[lang]}</a></li>)}
            </ul>
            <a class="sh-panel-all" href={L('recettes/')}>{u.nav.allRecipes} <Icon name="arrow" /></a>
          </div>
        </li>
        <li class="has-sub" data-sub>
          <button class="sh-link" type="button" aria-expanded="false" aria-controls="sous-menu-produits" aria-current={current === 'produits' ? 'page' : undefined}>
            {u.nav.products}<svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div class="sh-panel" id="sous-menu-produits">
            <ul>
              {site.products.map((p) => (
                <li><a href={L(`produits/${p.id}/`)}><span lang="it" class="latin">{p.name}</span> <small>{productDetails[p.id].tagline[lang]}</small></a></li>
              ))}
            </ul>
            <a class="sh-panel-all" href={L('produits/')}>{u.nav.allProducts} <Icon name="arrow" /></a>
          </div>
        </li>
        <li><a class="sh-link" href={L('notre-histoire/')} aria-current={current === 'histoire' ? 'page' : undefined}>{u.nav.story}</a></li>
        <li><a class="sh-link" href={L('contact/')} aria-current={current === 'contact' ? 'page' : undefined}>{u.nav.contact}</a></li>
        <li class="sh-drawer-only"><a class="pill pill--red pill--lg" href={L('professionnels/')}>{u.nav.cta}</a></li>
      </ul>
    </nav>

    <div class="sh-actions">
      <a class="pill pill--red sh-cta" href={L('professionnels/')} aria-current={current === 'pro' ? 'page' : undefined}>{u.nav.cta}</a>
      <a class="sh-lang" href={otherHref} hreflang={d.switcher.otherLang} lang={d.switcher.otherLang} title={d.a11y.langSwitch}>{d.switcher.otherLabel}</a>
      <a class="sh-icon" href={`${L('recettes/')}#recherche`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
        <span class="sr-only">{u.nav.search}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .sh {
    position: sticky;
    inset-block-start: 0;
    z-index: 60;
    block-size: var(--header-h);
    background: var(--paper);
    box-shadow: 0 1px 0 var(--line), 0 6px 18px -14px rgb(20 46 82 / 0.5);
  }
  .sh-inner { position: relative; display: flex; align-items: center; gap: var(--space-m); block-size: 100%; }

  /* Logo en médaillon qui déborde sous la barre */
  .sh-logo { position: relative; z-index: 2; flex: none; align-self: flex-start; margin-block-start: 0.45rem; border-radius: 50%; }
  .sh-logo img { inline-size: 11rem; block-size: auto; filter: drop-shadow(0 6px 10px rgb(20 46 82 / 0.25)); transition: transform 0.3s var(--ease-out); }
  @media (hover: hover) { .sh-logo:hover img { transform: translateY(2px) rotate(-1deg); } }

  .sh-nav { flex: 1; }
  .sh-list { display: flex; align-items: center; justify-content: center; gap: clamp(0.5rem, 1.6vw, 1.75rem); list-style: none; }
  .sh-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-block-size: 2.75rem;
    padding: 0.4rem 0.35rem;
    border: 0;
    background: none;
    color: var(--navy);
    font-size: 0.98rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    position: relative;
  }
  :lang(ar) .sh-link { font-size: 1.08rem; }
  .sh-link::after {
    content: '';
    position: absolute;
    inset-inline: 0.35rem;
    inset-block-end: 0.35rem;
    block-size: 2px;
    background: var(--red);
    transform: scaleX(0);
    transition: transform 0.3s var(--ease-out);
  }
  .sh-link[aria-current='page']::after { transform: scaleX(1); }
  @media (hover: hover) { .sh-link:hover::after { transform: scaleX(1); } }
  .chev { inline-size: 1rem; block-size: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; transition: transform 0.25s; }
  .sh-link[aria-expanded='true'] .chev { transform: rotate(180deg); }

  .has-sub { position: relative; }
  .sh-panel {
    position: absolute;
    inset-block-start: calc(100% + 0.6rem);
    inset-inline-start: 50%;
    translate: -50% 0;
    display: none;
    grid-template-columns: auto auto;
    gap: 0.25rem 1.5rem;
    min-inline-size: 26rem;
    padding: 1.1rem 1.25rem;
    background: var(--paper);
    border-radius: 1rem;
    box-shadow: var(--shadow-card), 0 0 0 1px var(--line);
  }
  :global([dir='rtl']) .sh-panel { translate: 50% 0; }
  #sous-menu-produits { grid-template-columns: 1fr; min-inline-size: 18rem; }
  .sh-panel::before { content: ''; position: absolute; inset-inline: 0; inset-block-start: -0.8rem; block-size: 0.8rem; }
  .sh-panel ul { list-style: none; display: grid; align-content: start; }
  .sh-panel a { display: block; padding: 0.45rem 0.5rem; border-radius: 0.5rem; color: var(--ink); text-decoration: none; }
  .sh-panel a small { display: block; font-size: 0.8rem; color: var(--ink-soft); }
  .sh-panel .latin { font-family: var(--font-body); font-weight: 600; color: var(--navy); }
  .sh-panel-feature { padding-inline-start: 1.25rem; border-inline-start: 1px solid var(--line); }
  .sh-panel-feature a { color: var(--navy); font-weight: 500; }
  @media (hover: hover) { .sh-panel a:hover { background: var(--milk); } }
  .sh-panel-all { grid-column: 1 / -1; display: inline-flex !important; align-items: center; gap: 0.4rem; margin-block-start: 0.4rem; color: var(--red) !important; font-weight: 600; }
  .sh-panel-all :global(svg) { inline-size: 1rem; block-size: 1rem; }
  :global([dir='rtl']) .sh-panel-all :global(svg) { transform: scaleX(-1); }

  .sh-actions { display: flex; align-items: center; gap: 0.6rem; flex: none; }
  .sh-lang {
    display: inline-flex; align-items: center; min-block-size: 2.5rem; padding: 0.3rem 0.85rem;
    border: 1.5px solid var(--navy); border-radius: 999px; color: var(--navy); font-size: 0.95rem; font-weight: 500; text-decoration: none;
  }
  .sh-lang:lang(ar) { font-family: var(--font-arabic); font-size: 1.05rem; }
  .sh-lang:lang(fr) { font-family: 'Work Sans', system-ui, sans-serif; }
  @media (hover: hover) { .sh-lang:hover { background: var(--navy); color: var(--milk); } }
  .sh-icon { display: grid; place-items: center; inline-size: 2.75rem; block-size: 2.75rem; border-radius: 50%; color: var(--navy); }
  .sh-icon svg { inline-size: 1.5rem; block-size: 1.5rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  @media (hover: hover) { .sh-icon:hover { background: var(--milk); } }

  .sh-burger { display: none; }
  .sh-drawer-only { display: none; }

  /* ---------- Ordinateur : menus au survol et au clic ---------- */
  @media (min-width: 1100px) {
    .has-sub:hover .sh-panel,
    .has-sub:focus-within .sh-panel,
    .sh-link[aria-expanded='true'] + .sh-panel { display: grid; }
  }

  /* ---------- Tablette / mobile : tiroir ---------- */
  @media (max-width: 1099.98px) {
    .sh-inner { display: grid; grid-template-columns: 1fr auto 1fr; gap: 0.5rem; }
    .sh-burger {
      display: grid; place-items: center; justify-self: start;
      inline-size: 2.75rem; block-size: 2.75rem; padding: 0; border: 0; border-radius: 50%; background: none; color: var(--navy); cursor: pointer;
    }
    .burger-lines { display: grid; gap: 5px; inline-size: 1.4rem; }
    .burger-lines span { block-size: 2px; background: currentColor; border-radius: 2px; transition: transform 0.3s var(--ease-out), opacity 0.2s; }
    .sh-burger[aria-expanded='true'] .burger-lines span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .sh-burger[aria-expanded='true'] .burger-lines span:nth-child(2) { opacity: 0; }
    .sh-burger[aria-expanded='true'] .burger-lines span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .sh-logo { justify-self: center; margin-block-start: 0.35rem; }
    .sh-logo img { inline-size: 8.5rem; }
    .sh-actions { justify-self: end; gap: 0.25rem; }
    .sh-cta { display: none; }

    .sh-nav {
      position: fixed;
      inset: var(--header-h) 0 0 0;
      z-index: 1;
      padding: var(--space-xl) var(--gutter) var(--space-l);
      background: var(--paper);
      overflow-y: auto;
      overscroll-behavior: contain;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out), visibility 0s 0.3s;
    }
    .sh-nav[data-open] { visibility: visible; opacity: 1; transform: none; transition: opacity 0.3s var(--ease-out), transform 0.3s var(--ease-out); }
    /* Sans JavaScript, le menu reste accessible : on l'affiche dans le flux */
    :global(html:not(.js)) .sh-nav { position: static; visibility: visible; opacity: 1; transform: none; padding: 0; background: none; }
    .sh-list { flex-direction: column; align-items: stretch; gap: 0; }
    .sh-list > li { border-block-end: 1px solid var(--line); }
    .sh-link { inline-size: 100%; justify-content: space-between; min-block-size: 3.5rem; font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; }
    :lang(ar) .sh-link { font-size: var(--step-2); }
    .sh-link::after { display: none; }
    .sh-panel {
      position: static; translate: none; min-inline-size: 0; padding: 0 0 1rem; box-shadow: none; background: none;
      grid-template-columns: 1fr;
    }
    :global([dir='rtl']) .sh-panel { translate: none; }
    .sh-panel::before { display: none; }
    .sh-link[aria-expanded='true'] + .sh-panel { display: grid; }
    .sh-panel-feature { padding: 0; border: 0; }
    .sh-drawer-only { display: block; border: 0 !important; padding-block-start: var(--space-l); }
    .sh-drawer-only .pill { inline-size: 100%; }
  }
  @media (max-width: 400px) {
    .sh-logo img { inline-size: 7.5rem; }
    .sh-lang { padding-inline: 0.6rem; }
  }
</style>
