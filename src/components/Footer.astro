---
import { t, localePath, type Lang } from '../i18n';
import { site } from '../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const all = t(lang);
const d = all.footer;
const year = new Date().getFullYear();
const home = localePath(lang);
const links = [
  ['#promesse', all.nav.promise],
  ['#savoir-faire', all.nav.craft],
  ['#mozzarellas', all.nav.products],
  ['#professionnels', all.nav.pro],
  ['#contact', all.nav.contact],
] as const;
const socials = Object.entries(site.social).filter(([, url]) => url);
---

<footer class="site-footer on-dark">
  <div class="tricolore" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src="/img/logo-ovale-480.webp" width="480" height="221" alt={`${site.name} · Fromagerie · Mozzarella 100 % naturelle`} loading="lazy" decoding="async" />
      <p>{d.tagline}</p>
    </div>
    <nav aria-label={all.a11y.mainNav} class="footer-nav">
      <ul>
        {links.map(([href, label]) => <li><a href={`${home}${href}`}>{label}</a></li>)}
        {socials.map(([name, url]) => <li><a href={url} target="_blank" rel="noopener" class="capitalize">{name}</a></li>)}
      </ul>
    </nav>
    <div class="footer-bottom">
      <p><span class="brand-word">© {year} {site.name}</span> · {d.rights}</p>
      <p>{d.made}</p>
      <a class="footer-lang" href={all.switcher.otherHref} hreflang={all.switcher.otherLang} lang={all.switcher.otherLang}>{all.switcher.otherLabel}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-deep); color: var(--milk); padding-block-end: env(safe-area-inset-bottom); }
  .footer-inner { display: grid; gap: var(--space-l); padding-block: var(--space-xl) var(--space-l); }
  @media (min-width: 900px) { .footer-inner { grid-template-columns: 1fr auto; align-items: start; } }
  .footer-brand img { inline-size: 15rem; block-size: auto; margin-block-end: var(--space-s); }
  .footer-brand p { color: var(--mist); max-inline-size: 28rem; }
  .footer-nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.5rem; list-style: none; }
  .footer-nav a { display: inline-block; padding-block: 0.5rem; text-decoration: none; color: var(--milk); }
  @media (hover: hover) { .footer-nav a:hover { text-decoration: underline; } }
  .capitalize { text-transform: capitalize; }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-block-start: var(--space-m);
    border-block-start: 1px solid var(--line-dark);
    font-size: var(--step--1);
    color: var(--mist);
  }
  :lang(ar) .footer-bottom { font-size: var(--step-0); }
  @media (min-width: 900px) { .footer-bottom { grid-column: 1 / -1; } }
  .footer-bottom p { margin: 0; }
  .footer-lang { margin-inline-start: auto; color: var(--milk); padding-block: 0.4rem; }
  .footer-lang:lang(ar) { font-family: var(--font-arabic); font-size: 1rem; }
  .footer-lang:lang(fr) { font-family: 'Work Sans', system-ui, sans-serif; }
  /* Laisse la place au bouton WhatsApp flottant sur mobile */
  @media (max-width: 1023.98px) { .site-footer { padding-block-end: calc(5rem + env(safe-area-inset-bottom)); } }
</style>
