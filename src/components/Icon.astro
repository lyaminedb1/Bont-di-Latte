---
// Icônes au trait, dessinées pour le site (1.5 px, coins arrondis).
interface Props { name: 'arrow' | 'whatsapp' | 'phone' | 'pin' | 'clock' | 'mail' | 'drop' | 'check' | 'down'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class:list={['icon', `icon-${name}`, cls]} viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"
  fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'down' && <path d="M12 4v15m-6-6 6 6 6-6" />}
  {name === 'check' && <path d="m5 12.5 4.2 4.2L19 7" />}
  {name === 'phone' && <path d="M5 4h3.2l1.6 4-2 1.3a11 11 0 0 0 5 5l1.3-2 4 1.6V17a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z" />}
  {name === 'pin' && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.3" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></>}
  {name === 'mail' && <><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'drop' && <path d="M12 3s-6 7.2-6 11a6 6 0 0 0 12 0c0-3.8-6-11-6-11Z" />}
  {name === 'whatsapp' && <><path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6Z" /><path d="M9.2 8.6c.2-.5.5-.5.8-.5h.5c.2 0 .4 0 .6.5l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.1-.2.3 0 .5.5.8 1.4 1.7 2.4 2.2.2.1.4.1.5 0l.6-.7c.2-.2.4-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .9-.7 1.7-1.6 1.8-1 .1-2.3-.3-3.9-1.5-1.6-1.3-2.6-2.9-2.8-3.9-.2-1 .1-1.8.3-2.4Z" fill="currentColor" stroke="none" /></>}
</svg>
