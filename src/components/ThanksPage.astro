---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Icon from './Icon.astro';
import { t, localePath, type Lang } from '../i18n';
import { whatsappLink } from '../config/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const all = t(lang);
const d = all.thanks;
---
<Base lang={lang} title={d.metaTitle} description={d.text} path="merci/" noindex>
  <Header lang={lang} simple />
  <main id="contenu" tabindex="-1" class="thanks">
    <div class="container thanks-inner">
      <img src="/img/symbole-192.webp" width="96" height="96" alt="" class="thanks-symbol" />
      <h1>{d.title}<span aria-hidden="true">.</span></h1>
      <p class="lead">{d.text}</p>
      <div class="thanks-ctas">
        <a class="btn" href={localePath(lang)}>{d.back}</a>
        <a class="btn btn--green" href={whatsappLink(all.pro.whatsappMessage)} target="_blank" rel="noopener">
          <Icon name="whatsapp" />{d.whatsapp}<span class="sr-only"> {all.a11y.newTab}</span>
        </a>
      </div>
    </div>
    <div class="tricolore thanks-filet" aria-hidden="true"><span></span><span></span><span></span></div>
  </main>
</Base>
<style>
  .thanks { position: relative; display: grid; place-items: center; min-block-size: 100vh; min-block-size: 100svh; padding-block: calc(var(--header-h) + var(--space-xl)) var(--space-xl); text-align: center; }
  .thanks-inner { display: grid; justify-items: center; gap: var(--space-m); max-inline-size: 42rem; }
  .thanks-symbol { inline-size: 6rem; block-size: 6rem; animation: settle 0.9s var(--ease-out) both; }
  .thanks h1 { font-size: var(--step-4); color: var(--navy-deep); }
  .thanks .lead { margin-inline: auto; }
  .thanks-ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-block-start: var(--space-s); }
  .thanks-filet { position: absolute; inset-inline: 0; inset-block-end: 0; }
  @keyframes settle { from { opacity: 0; transform: translateY(-24px) scale(0.9); } to { opacity: 1; transform: none; } }
</style>
