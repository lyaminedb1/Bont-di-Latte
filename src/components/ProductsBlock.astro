---
import { localePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';
import { site } from '../config/site';
import Carousel from './Carousel.astro';
import ProductCard from './ProductCard.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = ui[lang].productsBlock;
---
<section class="pb container section-tight" aria-labelledby="pb-title">
  <h2 id="pb-title" class="brand-title" data-reveal>{u.title}</h2>
  <div data-reveal style="--reveal-delay: 100ms">
    <Carousel lang={lang} label={u.title} item="min(82%, 20rem)" gap="1.5rem" class="pb-carousel">
      {site.products.map((p) => <li><ProductCard lang={lang} id={p.id} /></li>)}
    </Carousel>
  </div>
  <p class="pb-more"><a class="text-link" href={localePath(lang, 'produits/')}>{u.more}</a></p>
</section>
<style>
  .pb { display: grid; gap: var(--space-m); }
  .pb-more { text-align: center; margin: 0; }
  @media (min-width: 1024px) {
    .pb :global(.pb-carousel .carousel-track) { grid-auto-columns: calc((100% - 3rem) / 3); justify-content: center; }
  }
</style>
