---
import { localePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';
import FoodArt from './FoodArt.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const u = ui[lang].search;
---
<section class="sb container" aria-labelledby="sb-title">
  <div class="sb-inner">
    <div class="sb-art sb-art--a" aria-hidden="true"><FoodArt kind="bruschetta" bg="none" /></div>
    <div class="sb-art sb-art--b" aria-hidden="true"><FoodArt kind="caprese" bg="none" /></div>
    <div class="sb-card">
      <h2 id="sb-title" class="sb-title">{u.title}</h2>
      <form class="sb-form" action={localePath(lang, 'recettes/')} method="get" role="search">
        <label class="sr-only" for={`sb-q-${lang}`}>{u.label}</label>
        <input id={`sb-q-${lang}`} name="q" type="search" placeholder={u.placeholder} autocomplete="off" />
        <button type="submit" class="sb-btn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 5 5" /></svg>
          <span class="sr-only">{u.submit}</span>
        </button>
      </form>
    </div>
  </div>
</section>
<style>
  .sb { padding-block: var(--space-m) var(--space-l); }
  .sb-inner {
    position: relative;
    display: grid;
    place-items: center;
    min-block-size: clamp(11rem, 18vw, 14rem);
    padding: var(--space-l) var(--space-m);
    border-radius: var(--radius-l);
    background: var(--cream);
    overflow: hidden;
  }
  .sb-art { position: absolute; inset-block: -10%; inline-size: 42%; opacity: 0.95; }
  .sb-art--a { inset-inline-start: -8%; rotate: -8deg; }
  .sb-art--b { inset-inline-end: -10%; rotate: 10deg; }
  .sb-card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    inline-size: min(100%, 30rem);
    padding: 1.25rem 1.5rem 1.4rem;
    background: var(--paper);
    border-radius: 1.1rem;
    box-shadow: var(--shadow-card);
  }
  .sb-title { font-size: var(--step-3); font-weight: 600; color: var(--navy); text-align: center; }
  :lang(ar) .sb-title { font-weight: 700; }
  .sb-form { position: relative; inline-size: 100%; }
  .sb-form input {
    inline-size: 100%;
    min-block-size: 3rem;
    padding-block: 0.6rem;
    padding-inline: 1.1rem 3.4rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--milk);
    color: var(--ink);
    font-size: 1rem;
  }
  .sb-form input::placeholder { color: var(--ink-soft); opacity: 1; }
  .sb-form input:focus-visible { outline: 3px solid var(--navy); outline-offset: 2px; }
  .sb-btn {
    position: absolute; inset-block: 0.3rem; inset-inline-end: 0.3rem;
    display: grid; place-items: center; inline-size: 2.4rem; border: 0; border-radius: 50%;
    background: var(--red); color: var(--milk); cursor: pointer;
  }
  .sb-btn svg { inline-size: 1.15rem; block-size: 1.15rem; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; }
  @media (max-width: 639.98px) {
    .sb { padding-inline: 0; padding-block-start: 0; }
    .sb-inner { border-radius: 0; padding-block: var(--space-xl) var(--space-l); }
    .sb-art { inline-size: 70%; opacity: 0.55; }
  }
</style>
