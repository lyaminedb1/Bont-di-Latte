---
import { t, type Lang } from '../i18n';
import { whatsappLink } from '../config/site';
import Icon from './Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---
<a class="wa-fab" href={whatsappLink(d.contact.whatsappMessage)} target="_blank" rel="noopener" data-fab data-hidden>
  <Icon name="whatsapp" />
  <span class="sr-only">{d.a11y.whatsappFab} {d.a11y.newTab}</span>
</a>
<style>
  .wa-fab {
    position: fixed;
    inset-inline-end: max(1rem, env(safe-area-inset-right));
    inset-block-end: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    place-items: center;
    inline-size: 3.6rem;
    block-size: 3.6rem;
    border-radius: 50%;
    background: var(--green);
    color: var(--milk);
    box-shadow: 0 12px 28px -10px rgb(20 46 82 / 0.6), 0 0 0 3px var(--milk);
    transition: transform 0.35s var(--ease-out), opacity 0.35s;
  }
  [dir='rtl'] .wa-fab { inset-inline-end: max(1rem, env(safe-area-inset-left)); }
  .wa-fab :global(svg) { inline-size: 1.8rem; block-size: 1.8rem; }
  .wa-fab:active { transform: scale(0.94); }
  .js .wa-fab[data-hidden] { opacity: 0; transform: translateY(1rem) scale(0.9); pointer-events: none; visibility: hidden; transition: transform 0.35s var(--ease-out), opacity 0.35s, visibility 0s 0.35s; }
  @media (min-width: 1024px) { .wa-fab { display: none; } }
</style>
