---
import { t, type Lang } from '../i18n';
import { findVideo } from '../lib/media';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang).hero;

// Vidéos détectées au build : si absentes, le héros affiche l'animation CSS de la goutte.
const wide = findVideo('hero-16x9');
const tall = findVideo('hero-9x16');
const hasVideo = Boolean(wide || tall);
const desktopPoster = wide?.poster ?? tall?.poster;
const mobilePoster = tall?.poster ?? wide?.poster;
---

<section class="hero on-dark" aria-labelledby="hero-title" data-hero>
  <div class="hero-stage">
  <div class="hero-media">
    {hasVideo ? (
      <>
        {/* Image de repli (mouvement réduit, économie de données) : la bonne image selon l'écran */}
        <picture class="hero-poster">
          {mobilePoster && <source media="(max-aspect-ratio: 4/5)" srcset={mobilePoster} />}
          <img src={desktopPoster} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
        </picture>
        <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster={mobilePoster}
          data-hero-video data-poster-wide={desktopPoster} aria-label={d.videoLabel}>
          {tall?.webm && <source src={tall.webm} type="video/webm" media="(max-aspect-ratio: 4/5)" />}
          {tall && <source src={tall.mp4} type="video/mp4" media="(max-aspect-ratio: 4/5)" />}
          {wide?.webm && <source src={wide.webm} type="video/webm" />}
          {wide && <source src={wide.mp4} type="video/mp4" />}
        </video>
        {/* Exécuté immédiatement : coupe la vidéo avant téléchargement si mouvement réduit ou économie de données */}
        <script is:inline>
          (function () {
            var v = document.querySelector('[data-hero-video]');
            if (!v) return;
            var c = navigator.connection;
            var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduce || (c && c.saveData)) {
              v.removeAttribute('autoplay');
              v.querySelectorAll('source').forEach(function (s) { s.remove(); });
              v.load();
              v.hidden = true;
              return;
            }
            // Poster vertical par défaut (mobile d'abord) ; version large sur écran horizontal
            if (v.dataset.posterWide && !window.matchMedia('(max-aspect-ratio: 4/5)').matches) v.poster = v.dataset.posterWide;
          })();
        </script>
      </>
    ) : (
      <div class="hero-drop" aria-hidden="true">
        <span class="drop"></span>
        <span class="ripple"></span>
        <span class="ripple ripple--2"></span>
        <img class="hero-logo" src="/img/logo-ovale-960.webp" srcset="/img/logo-ovale-480.webp 480w, /img/logo-ovale-720.webp 720w, /img/logo-ovale-960.webp 960w"
          sizes="(max-width: 640px) 84vw, 30rem" width="960" height="443" alt="" fetchpriority="high" />
      </div>
    )}
  </div>
  </div>

  <div class="container hero-content">
    <p class="kicker rise">{d.eyebrow}</p>
    <h1 id="hero-title" class="rise" style="--d: 60ms">
      {d.titleBefore}<em>{d.titleEm}</em>{d.titleAfter}
    </h1>
    <p class="hero-sub rise" style="--d: 120ms">{d.subtitle}</p>
    <div class="hero-ctas rise" style="--d: 180ms">
      <a class="btn btn--milk" href="#mozzarellas">{d.ctaPrimary}<Icon name="arrow" /></a>
      <a class="btn btn--ghost-light" href="#professionnels">{d.ctaSecondary}</a>
    </div>
    <ul class="hero-badges rise" style="--d: 240ms">
      {d.badges.map((b) => (
        <li lang={b.startsWith('Fatta') ? 'it' : undefined}><Icon name="drop" />{b}</li>
      ))}
    </ul>
  </div>

  <a class="hero-scroll" href="#promesse"><span>{d.scroll}</span><Icon name="down" /></a>
</section>

<style>
  /* Mobile : la vidéo en haut, le texte dessous (jamais de texte posé sur le logo).
     Ordinateur : texte à gauche (à droite en arabe), vidéo de l'autre côté. */
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: minmax(40svh, 1fr) auto;
    min-block-size: 100vh;
    min-block-size: 100svh;
    padding-block-end: var(--space-xl);
    background: radial-gradient(ellipse 90% 60% at 50% 28%, #1f4475 0%, var(--navy-deep) 72%);
    color: var(--milk);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-stage { position: relative; min-block-size: 0; margin-block-start: var(--header-h); }
  .hero-media {
    position: absolute;
    inset: 0;
    /* fondu des bords : la vidéo se fond dans le bleu du héros */
    -webkit-mask-image: linear-gradient(to bottom, #000 72%, transparent);
    mask-image: linear-gradient(to bottom, #000 72%, transparent);
  }
  .hero-poster img, .hero-video { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  .hero-video { background: transparent; }

  .hero-content { position: relative; padding-block-start: var(--space-s); }
  /* Apparition au chargement, en CSS pur (n'attend pas le JavaScript : meilleur LCP) */
  .rise { animation: rise 0.6s var(--ease-out) var(--d, 0ms) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  .hero h1 { max-inline-size: 13ch; font-size: var(--step-5); font-weight: 500; line-height: 1; }
  :lang(ar) .hero h1 { max-inline-size: 14ch; line-height: 1.3; }
  .hero h1 em { color: var(--milk); }
  .hero-sub { max-inline-size: 36rem; margin-block: var(--space-m) var(--space-l); font-size: var(--step-1); color: var(--mist); }
  .hero-ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .hero-badges { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-block-start: var(--space-l); list-style: none; }
  .hero-badges li {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: var(--step--1); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--milk);
  }
  :lang(ar) .hero-badges li:not([lang]) { letter-spacing: 0; font-size: var(--step-0); }
  .hero-badges li[lang='it'] { font-family: inherit; font-style: italic; text-transform: none; letter-spacing: 0.04em; font-size: var(--step-0); }
  :lang(ar) .hero-badges li[lang='it'] { font-family: 'Work Sans', sans-serif; }
  .hero-badges :global(svg) { inline-size: 0.95rem; block-size: 0.95rem; fill: var(--milk); stroke: none; }

  .hero-scroll {
    position: absolute; inset-inline-end: var(--gutter); inset-block-end: var(--space-l);
    display: none; align-items: center; gap: 0.5rem;
    font-size: var(--step--1); letter-spacing: 0.16em; text-transform: uppercase; text-decoration: none; color: var(--mist);
  }
  :lang(ar) .hero-scroll { letter-spacing: 0; }
  .hero-scroll :global(svg) { inline-size: 1.1rem; animation: nudge 2.4s var(--ease-out) infinite; }
  @keyframes nudge { 0%, 60%, 100% { transform: none; } 30% { transform: translateY(5px); } }

  @media (min-width: 640px) and (max-width: 1023.98px) {
    .hero { grid-template-rows: minmax(46svh, 1fr) auto; }
  }

  @media (min-width: 1024px) {
    .hero { grid-template-rows: 1fr; align-items: center; padding-block: calc(var(--header-h) + var(--space-l)) var(--space-xl); }
    .hero-stage { position: absolute; inset-block: 0; inset-inline-end: 0; inline-size: 55%; margin: 0; }
    .hero-media {
      -webkit-mask-image: linear-gradient(to var(--fade-to, right), transparent 0%, #000 22%, #000 88%, transparent);
      mask-image: linear-gradient(to var(--fade-to, right), transparent 0%, #000 22%, #000 88%, transparent);
    }
    [dir='rtl'] .hero-media { --fade-to: left; }
    .hero-poster img, .hero-video { object-fit: contain; }
    .hero-content { padding-block: 0; }
    .hero-content > * { max-inline-size: min(34rem, 40%); }
    .hero h1 { max-inline-size: 10ch; }
    :lang(ar) .hero h1 { max-inline-size: 11ch; }
  }
  @media (min-width: 1024px) and (min-height: 700px) { .hero-scroll { display: inline-flex; } }

  /* ---------- Repli sans vidéo : la goutte tombe, l'onde, puis le logo ---------- */
  .hero-drop { position: absolute; inset: 0; display: grid; place-items: center; }
  .hero-drop > * { grid-area: 1 / 1; }
  .hero-logo {
    inline-size: min(84vw, 30rem, 90%);
    block-size: auto;
    opacity: 0;
    transform: scale(0.94);
    animation: logo-in 0.7s var(--ease-out) 0.62s forwards;
    filter: drop-shadow(0 20px 40px rgb(0 0 0 / 0.25));
  }
  .drop {
    inline-size: 1.1rem; block-size: 1.5rem; background: var(--milk);
    -webkit-mask: var(--drop-mask) center / contain no-repeat;
    mask: var(--drop-mask) center / contain no-repeat;
    opacity: 0;
    animation: drop-fall 0.6s cubic-bezier(0.55, 0, 0.9, 0.4) 0.05s forwards;
  }
  .ripple {
    inline-size: 9rem; block-size: 2.2rem; border: 1.5px solid rgb(247 240 230 / 0.7); border-radius: 50%;
    opacity: 0; transform: scale(0.1);
    animation: ripple 1.1s var(--ease-out) 0.6s forwards;
  }
  .ripple--2 { animation-delay: 0.8s; }
  @keyframes drop-fall {
    0% { opacity: 0; transform: translateY(-30vh) scaleY(1.1); }
    15% { opacity: 1; }
    95% { opacity: 1; transform: translateY(0) scaleY(1.2); }
    100% { opacity: 0; transform: translateY(0) scale(1.6, 0.4); }
  }
  @keyframes ripple { 0% { opacity: 0.9; transform: scale(0.1); } 100% { opacity: 0; transform: scale(2.6); } }
  @keyframes logo-in { to { opacity: 1; transform: none; } }

  /* Effet de profondeur léger : la scène s'éloigne pendant le défilement (sans JS) */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-media {
        animation: hero-depth linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      @keyframes hero-depth { to { transform: translateY(14vh) scale(1.05); opacity: 0.4; } }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-logo { opacity: 1; transform: none; animation: none; }
    .drop, .ripple { display: none; }
    .hero-scroll :global(svg) { animation: none; }
    .rise { animation: none; }
  }
</style>
