---
// Illustrations des produits (utilisées tant qu'aucune photo n'est fournie dans site.ts).
interface Props { kind: 'boule' | 'billes' | 'pain'; label: string }
const { kind, label } = Astro.props;
---
<svg class="product-art" viewBox="0 0 320 240" role="img" aria-label={label}>
  <defs>
    <radialGradient id={`m-${kind}`} cx="38%" cy="32%" r="75%">
      <stop offset="0" stop-color="#FFFDF9" />
      <stop offset=".55" stop-color="#F7F0E6" />
      <stop offset="1" stop-color="#E4D5BE" />
    </radialGradient>
  </defs>
  <!-- assiette / planche -->
  <ellipse cx="160" cy="196" rx="132" ry="22" fill="#E4D5BE" opacity=".6" />
  {kind === 'boule' && (
    <g>
      <path d="M78 150c0-54 37-92 82-92s82 38 82 92c0 30-37 46-82 46s-82-16-82-46Z" fill={`url(#m-${kind})`} stroke="#1C3F6E" stroke-width="2" />
      <path d="M136 66c-4 8 0 18 10 20" fill="none" stroke="#1C3F6E" stroke-width="2" stroke-linecap="round" />
      <path d="M104 130c10-30 34-50 58-52" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" opacity=".9" />
      <path d="M232 92c10-8 22-8 30-2M246 76c6-10 18-14 28-10" fill="none" stroke="#1E7B4A" stroke-width="2.4" stroke-linecap="round" />
      <ellipse cx="262" cy="86" rx="12" ry="6" transform="rotate(-25 262 86)" fill="#1E7B4A" opacity=".85" />
    </g>
  )}
  {kind === 'billes' && (
    <g stroke="#1C3F6E" stroke-width="2">
      <circle cx="104" cy="160" r="34" fill={`url(#m-${kind})`} />
      <circle cx="166" cy="168" r="30" fill={`url(#m-${kind})`} />
      <circle cx="222" cy="156" r="33" fill={`url(#m-${kind})`} />
      <circle cx="136" cy="112" r="31" fill={`url(#m-${kind})`} />
      <circle cx="196" cy="108" r="29" fill={`url(#m-${kind})`} />
      <path d="M92 150c4-10 12-16 20-18M126 104c4-8 10-12 18-14M186 100c4-8 10-11 16-12" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" />
      <circle cx="258" cy="190" r="9" fill="#C8322B" stroke="none" />
      <circle cx="70" cy="190" r="7" fill="#C8322B" stroke="none" opacity=".85" />
    </g>
  )}
  {kind === 'pain' && (
    <g>
      <path d="M58 118c0-18 14-30 32-30h140c18 0 32 12 32 30v54c0 10-8 18-18 18H76c-10 0-18-8-18-18Z" fill={`url(#m-${kind})`} stroke="#1C3F6E" stroke-width="2" />
      <path d="M58 132h204" stroke="#1C3F6E" stroke-width="1.4" opacity=".35" />
      <path d="M86 106c30-6 90-6 140 0" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" />
      <g fill="#F7F0E6" stroke="#1C3F6E" stroke-width="1.6">
        <path d="M244 196l26-48 22 4-20 48Z" />
        <path d="M222 200l20-46 22 2-16 46Z" />
      </g>
    </g>
  )}
</svg>
<style>
  .product-art { inline-size: 100%; block-size: auto; }
</style>
